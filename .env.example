# Environment
NODE_ENV=development
PORT=3000

# API Settings
API_PREFIX=api

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/domera_db?schema=public

# JWT Security
JWT_ACCESS_SECRET=domera_super_secret_access_key_2026_change_in_prod
JWT_REFRESH_SECRET=domera_super_secret_refresh_key_2026_change_in_prod
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Initial Admin Seed Configuration
ADMIN_NAME=Admin User
ADMIN_EMAIL=admin@domera.com
# ADMIN_PHONE=<optional, NOT the review number>
ADMIN_PASSWORD=AdminPassword123!

# Security & CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:5173
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Firebase Cloud Messaging (push notifications) — set ONE of these.
# Service account JSON: Firebase Console > Project settings > Service accounts > Generate new private key
# FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# FIREBASE_SERVICE_ACCOUNT_BASE64=<base64 of the JSON file>

# Optional
# AUTH_RATE_LIMIT=10          # login/register attempts per IP per minute
# SWAGGER_ENABLED=true        # false hides /api/docs
# TRUST_PROXY=true            # only when running behind nginx/Caddy

# Phone registration: POST /api/auth/register/request-code → /verify-code → /complete
# OTP_DEV_MODE=true returns the 6-digit code in the request-code response (field "devCode") so the
# app can show it on screen. Development/test ONLY: the server refuses to start with
# NODE_ENV=production and OTP_DEV_MODE=true. Default: false (code is never returned).
OTP_DEV_MODE=true
OTP_EXPIRY_MINUTES=3
OTP_MAX_ATTEMPTS=5

# Eskiz.uz SMS
#   SMS_MODE=off   no SMS (default). Registration works only with OTP_DEV_MODE=true (dev)
#   SMS_MODE=test  Eskiz account in TEST MODE: sends only ESKIZ_TEST_MESSAGE, never the code.
#                  Registration still needs OTP_DEV_MODE=true; in production request-code returns 503
#   SMS_MODE=live  sends OTP_MESSAGE_TEMPLATE with the code. Only after Eskiz approved the template
# Check the setup:  npm run sms:check   (login only, no SMS)
SMS_MODE=off
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546
ESKIZ_BASE_URL=https://notify.eskiz.uz/api
# One of: This is test from Eskiz | Bu Eskiz dan test | Это тест от Eskiz
ESKIZ_TEST_MESSAGE="This is test from Eskiz"
# Must match the Eskiz-approved template character for character; {code} = the 6 digits.
# Keep the double quotes (a # inside an unquoted value starts a comment).
OTP_MESSAGE_TEMPLATE="DOMERA: tasdiqlash kodingiz {code}"

# App Store / Google Play review account (created/updated on every start, role USER)
# Reviewer signs in like a user: phone → code. REVIEW_PHONE always accepts REVIEW_OTP_CODE
# (no SMS, no limits) as long as the number belongs to a USER account, never admin/manager/agent.
# Put the real values only in the server .env and in App Store Connect / Play Console, not in git.
# REVIEW_EMAIL=review@domera.uz
# REVIEW_PHONE=+998XXXXXXXXX
# REVIEW_OTP_CODE=<6 digits>
# REVIEW_PASSWORD=<also allows /auth/login with phone or email + password>

# HTTPS: run behind Caddy on the same server and listen on localhost only
# HOST=127.0.0.1
