# HTTPS for the PM2 deployment (Caddy installed directly on the server, not in Docker).
# Copy to /etc/caddy/Caddyfile, replace api.domera.uz with your domain, then: systemctl reload caddy
# The domain's DNS A record must point to this server; ports 80 and 443 must be open.
# Caddy gets and renews the Let's Encrypt certificate automatically and redirects HTTP -> HTTPS.
api.domera.uz {
	encode gzip

	request_body {
		max_size 10MB
	}

	header Strict-Transport-Security "max-age=31536000"

	reverse_proxy 127.0.0.1:3000
}
